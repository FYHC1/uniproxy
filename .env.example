# Copy settings into the process environment (or Docker Compose env_file).
UNIPROXY_HOST=127.0.0.1
UNIPROXY_PORT=9090
# Default is the platform standard location (ProgramData\UniProxy,
# /var/lib/uniproxy, ~/Library/Application Support/UniProxy).
# UNIPROXY_DATA_DIR=/var/lib/uniproxy
# Required if binding the admin service to a non-loopback address (minimum 24 chars).
# UNIPROXY_ADMIN_TOKEN=replace-with-a-long-random-secret
# UNIPROXY_CORE_PATH=./bin/mihomo.exe
# Private/LAN subscription URLs are blocked unless explicitly enabled.
# UNIPROXY_ALLOW_PRIVATE_SUBSCRIPTIONS=false
# Optional exact comma-separated browser origins (reverse proxy deployments).
# UNIPROXY_ALLOWED_ORIGINS=https://proxy.example.com
