{
  "name": "uniproxy",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"go run ./cmd/uniproxy\" \"vite --host 127.0.0.1\"",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-binaries.mjs",
    "build:web": "tsc --noEmit && vite build",
    "test": "go test ./...",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:ui": "node --test src/web/tests/utils.test.mjs && node src/web/tests/verify.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@phosphor-icons/react": "^2.1.10"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@playwright/test": "^1.56.1",
    "concurrently": "^9.2.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  }
}
